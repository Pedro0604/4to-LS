<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2025101805079" targetNamespace="http://www.bizagi.com/definitions/_2025101805079" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_0c3646e3-7ee3-4212-8486-b80cc0e50102" name="Proceso principal">
    <documentation />
    <laneSet id="Id_21f61bc2-606b-4ed8-bc7c-5163ed30d745" />
  </process>
  <process id="Id_6a321a50-6226-4a8c-8761-2efbad5c42a8" name="Envasado y Etiquetado">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Preparar l&amp;iacute;nea, envasar, cerrar, marcar, etiquetar, controlar calidad y transferir lote.&lt;/span&gt;&lt;/p&gt;</documentation>
    <laneSet id="Id_c096f530-81e7-4ed6-bdc0-19efa172c88d">
      <lane id="Id_3e5cf3ad-3b26-4f86-8aac-efd44f7ada6c" name="Departamento de control de calidad">
        <documentation />
        <childLaneSet id="Id_82b3cb56-1abf-49df-895f-c2f496c4057a" />
      </lane>
      <lane id="Id_2d947096-5d0c-4c97-80ee-1bde99383706" name="Departamento de fabricación de bebidas">
        <documentation />
        <childLaneSet id="Id_3b62dd2f-d434-49aa-9710-be813eeaa81f" />
      </lane>
      <lane id="Id_8bb8a8d6-5f1b-45a9-a91c-bec73b271d11" name="Departamento de inventario">
        <documentation />
        <childLaneSet id="Id_bdb1c1b8-5518-40b9-ac04-afc83983ec1e" />
      </lane>
    </laneSet>
    <dataObject id="Id_4477a0ba-da97-4157-a1a5-20efbef444f1" name="Informe de no conformidad">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Es el informe en papel de la no conformidad&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#F0F0F0" />
            <bizagi:BizagiProperty name="borderColor" value="#666666" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
          <bizagi:BizagiExtendedAttributeValues>
            <bizagi:BizagiExtendedAttributeValue Id="bc788ab5-4e6e-411f-ac04-a8398df56964" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;El documento impreso contiene los siguientes grupos de atributos:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; Cabecera:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;1. Fecha actual&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;2. N&amp;uacute;mero de identificaci&amp;oacute;n del informe&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;3. Fecha y hora de detecci&amp;oacute;n&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;4. Responsable que emite el informe&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;5. Producto&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;6. N&amp;uacute;mero de lote&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;7. N&amp;uacute;mero de orden de producci&amp;oacute;n&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; Cuerpo:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;1. Requisito que no fue cumplido&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;2. Descripci&amp;oacute;n del desv&amp;iacute;o y evidencias (fotos, mediciones, etc.)&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;3. Cantidad afectada&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;4. Acciones a seguir&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; Pie:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 54pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;1. Firma del responsable que emite el informe&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <dataState id="Id_da9a123d-3223-4274-ac38-893a8ea6dea5" name="" />
    </dataObject>
    <startEvent id="Id_3733b670-2edc-4c23-9f8a-4803dc610848" name="Iniciar envasado">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Se desencadena el proceso de envasado y etiquetado de un lote ante la llegada de una orden de producci&amp;oacute;n&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_ea42fa49-4a8b-48f7-9c19-dd16d740add4</outgoing>
    </startEvent>
    <exclusiveGateway id="Id_359ca4d4-0322-4059-8a92-3355a703248b" name="¿Materiales disponibles?" gatewayDirection="Diverging">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Decide por disponibilidad&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt; emitida por la verificaci&amp;oacute;n de materiales&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
          <bizagi:BizagiExtendedAttributeValues>
            <bizagi:BizagiExtendedAttributeValue Id="56eadbb8-8a09-4e79-96b4-a12c903a4dfc" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Valor 0: No tiene materiales disponibles&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Valor 1: Tiene materiales disponibles&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="ca9a29f3-f9d8-4c5d-9e2c-27f52abe6213" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Valor 1: Materiales disponibles. Contin&amp;uacute;a el proceso de envasado y etiquetado hacia Sanitizar y preparar l&amp;iacute;nea&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="b4c34cb4-3bb7-4eb3-a0e1-7fe47ef1da47" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Valor 0: Materiales no disponibles. Se solicita la reposici&amp;oacute;n a dep&amp;oacute;sitos&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_b421deaf-4d68-46dc-95c6-1fc2ccdb05e3</incoming>
      <outgoing>Id_77ee231a-f71d-47e8-b201-ee20883bfb64</outgoing>
      <outgoing>Id_f55e3138-d25d-437b-af0a-b3635439fc42</outgoing>
    </exclusiveGateway>
    <sendTask id="Id_5a4584d3-0998-41f7-a95d-d512eb25ae2f" name="Solicitar reposición a Inventario">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Emite una solicitud de reposici&amp;oacute;n al Departamento de Inventario con &amp;iacute;tems y cantidades faltantes&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
          <bizagi:BizagiExtendedAttributeValues>
            <bizagi:BizagiExtendedAttributeValue Id="9210f495-504e-41b1-880e-83a8f392bc3c" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Se tiene acceso al listado con los detalles de los materiales faltantes&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="1bfba9d0-d870-49ff-ac12-f784a6188b7a" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Solicitud de reposici&amp;oacute;n enviada al Departamento de Inventario&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_f55e3138-d25d-437b-af0a-b3635439fc42</incoming>
    </sendTask>
    <receiveTask id="Id_8e5c6690-918e-4f5a-a626-76c9c06fb125" name="Recibir solicitud de reposición">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Recibe la solicitud de reposici&amp;oacute;n, asigna un pedido interno para obtener los materiales necesarios y reprograma el envasado y etiquetado del lote&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
          <bizagi:BizagiExtendedAttributeValues>
            <bizagi:BizagiExtendedAttributeValue Id="bc62c6c5-b3d6-4407-b65b-d48bd6a8ecf6" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Se envi&amp;oacute; correctamente una solicitud de reposici&amp;oacute;n&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="79e4ec3a-2ccf-48fa-b085-7f0fe36a9273" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Reprogramaci&amp;oacute;n del envasado y etiquetado del lote&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Pedido interno de materiales faltantes realizado&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_fb4fcfdb-c106-46af-9359-57414e80269f</outgoing>
    </receiveTask>
    <endEvent id="Id_180f3e30-1d75-4457-9e07-35ee2558e020" name="Fin por materiales faltantes">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Fin del proceso por materiales necesarios faltantes&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_fb4fcfdb-c106-46af-9359-57414e80269f</incoming>
    </endEvent>
    <manualTask id="Id_e6624134-b0eb-48c2-9294-4e49917ad6a6" name="Sanitizar y preparar línea">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Limpieza de la l&amp;iacute;nea de envasado y preparaci&amp;oacute;n necesaria para el proceso, configurando la llenadora, cerradora, codificadora y etiquetadora&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
          <bizagi:BizagiExtendedAttributeValues>
            <bizagi:BizagiExtendedAttributeValue Id="97807b7a-dec5-4c0b-bb59-3c57f1fb48d6" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Los materiales necesarios est&amp;aacute;n disponibles&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;La l&amp;iacute;nea de trabajo est&amp;aacute; libre para usarla&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="ad3442f0-da23-44b2-966c-ad0b1491b284" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;L&amp;iacute;nea de envasado habilitada y lista para comenzar el llenado de los envases&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_77ee231a-f71d-47e8-b201-ee20883bfb64</incoming>
      <outgoing>Id_8ed924d5-09a5-4c00-af20-8cb8b894a8dd</outgoing>
    </manualTask>
    <manualTask id="Id_4cf80c41-b5a7-4a7f-819b-3fe1be40e5e6" name="Análisis de lote">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Se analiza la conformidad del lote mediante un plan de muestreo. Se examinan: cantidad de producto adecuado, unidad cerrada correctamente, n&amp;uacute;mero de lote y fechas en envase legibles y r&amp;oacute;tulo adecuadamente colocado y legible&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
