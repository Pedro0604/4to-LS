    <manualTask id="Id_4cf80c41-b5a7-4a7f-819b-3fe1be40e5e6" name="Analisis de lote">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Se analiza la conformidad del lote mediante un plan de muestreo. Se examinan: cantidad de producto adecuado, unidad cerrada correctamente, n&amp;uacute;mero de lote y fechas en envase legibles y r&amp;oacute;tulo adecuadamente colocado y legible&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
          <bizagi:BizagiExtendedAttributeValues>
            <bizagi:BizagiExtendedAttributeValue Id="97807b7a-dec5-4c0b-bb59-3c57f1fb48d6" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Operaci&amp;oacute;n de l&amp;iacute;nea de envasado y etiquetado finalizada&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="ad3442f0-da23-44b2-966c-ad0b1491b284" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Resultado del an&amp;aacute;lisis: Conforme = 1 / No Conforme = 0&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_d26abd0a-5784-4d57-905f-3f98334864f1</incoming>
      <outgoing>Id_9d1f2f23-d64c-4438-8f4b-acdf63055121</outgoing>
    </manualTask>
    <exclusiveGateway id="Id_9736b78b-0ba4-45d6-a31a-385b03b58950" name="¿Lote conforme?" gatewayDirection="Diverging">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Decide seg&amp;uacute;n el an&amp;aacute;lisis de conformidad del lote&lt;/span&gt;&lt;/p&gt;</documentation>
