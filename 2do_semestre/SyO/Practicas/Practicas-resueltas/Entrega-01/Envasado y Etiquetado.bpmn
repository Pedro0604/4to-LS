    <manualTask id="Id_d8546884-357f-4820-9f55-935e8e523611" name="Llenar envases">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Se dosifica el producto a granel en cada envase, seg&amp;uacute;n el volumen necesario&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
          <bizagi:BizagiExtendedAttributeValues>
            <bizagi:BizagiExtendedAttributeValue Id="97807b7a-dec5-4c0b-bb59-3c57f1fb48d6" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;La l&amp;iacute;nea de envasado est&amp;aacute; habilitada y sanitizada&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;El producto a granel y los envases est&amp;aacute;n disponibles&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="ad3442f0-da23-44b2-966c-ad0b1491b284" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Envases llenos adecuadamente y en la banda de transporte hacia la zona de cerrado&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_8ed924d5-09a5-4c00-af20-8cb8b894a8dd</incoming>
      <outgoing>Id_88ff3720-afe1-4bb8-aad7-aae2d3c9dcf5</outgoing>
    </manualTask>
    <manualTask id="Id_b80e53c0-78ec-403f-ab62-1d23da6f9a5e" name="Cerrar y sellar">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Coloca tapa y sella herm&amp;eacute;ticamente la botella&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
          <bizagi:BizagiExtendedAttributeValues>
            <bizagi:BizagiExtendedAttributeValue Id="97807b7a-dec5-4c0b-bb59-3c57f1fb48d6" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Hay envases llenos en la banda de transporte de entrada a la zona&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Hay tapas disponibles&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="ad3442f0-da23-44b2-966c-ad0b1491b284" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Unidades selladas y en la banda de transporte hacia la zona de marcado de envase&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_88ff3720-afe1-4bb8-aad7-aae2d3c9dcf5</incoming>
      <outgoing>Id_a94b4a41-afc6-423d-886b-154238cb911d</outgoing>
    </manualTask>
    <manualTask id="Id_e62b9035-9727-4561-b7fd-0f548df83af0" name="Marcar envase">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Coloca n&amp;uacute;mero de lote, fecha de elaboraci&amp;oacute;n y de vencimiento sobre el pl&amp;aacute;stico del envase&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
          <bizagi:BizagiExtendedAttributeValues>
            <bizagi:BizagiExtendedAttributeValue Id="97807b7a-dec5-4c0b-bb59-3c57f1fb48d6" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Hay unidades selladas en la banda de transporte de entrada a la zona&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="ad3442f0-da23-44b2-966c-ad0b1491b284" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Unidades marcadas y en la banda de transporte hacia la zona de etiquetado&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_a94b4a41-afc6-423d-886b-154238cb911d</incoming>
      <outgoing>Id_190a8c4d-31a8-4cfd-9583-5e4dff10a35e</outgoing>
    </manualTask>
    <manualTask id="Id_fed0fd96-2f8a-496f-8b86-0ff079d072a0" name="Colocar rótulos">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Coloca las etiquetas envolventes alrededor del producto&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
          <bizagi:BizagiExtendedAttributeValues>
            <bizagi:BizagiExtendedAttributeValue Id="97807b7a-dec5-4c0b-bb59-3c57f1fb48d6" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Hay unidades marcadas en la banda de transporte de entrada a la zona&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Hay rollos de etiquetas disponibles&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="ad3442f0-da23-44b2-966c-ad0b1491b284" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Unidades rotuladas&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Lote listo para el an&amp;aacute;lisis de conformidad&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
