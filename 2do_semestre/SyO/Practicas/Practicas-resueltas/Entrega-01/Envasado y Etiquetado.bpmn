            <bizagi:BizagiExtendedAttributeValue Id="56eadbb8-8a09-4e79-96b4-a12c903a4dfc" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Valor 0: Lote no conforme&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Valor 1: Lote conforme&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
