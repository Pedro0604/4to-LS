    <participant id="Id_9c2bd85f-1d23-458f-9f33-28f0d134bb69" name="Envasado y Etiquetado" processRef="Id_6a321a50-6226-4a8c-8761-2efbad5c42a8">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Preparar l&amp;iacute;nea, envasar, cerrar, marcar, etiquetar, controlar calidad y transferir lote.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="White" />
            <bizagi:BizagiProperty name="borderColor" value="Black" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
          <bizagi:BizagiExtendedAttributeValues>
            <bizagi:BizagiExtendedAttributeValue Id="d30e714e-a814-4643-bace-0d857977afcd" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Obtener lotes conformes, trazables y listos para el despacho&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="1e8807f0-12f9-4800-8c17-3951ced37fc8" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Orden de producci&amp;oacute;n, producto a granel, envases, tapas, etiquetas, especificaciones de proceso, plan de muestreo, par&amp;aacute;metros legales de r&amp;oacute;tulo&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="8bd53989-d9dc-4a48-bcf8-315d227cd897" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Lote conforme registrado e inventariado.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Lote no conforme separado con un informe de no conformidad.&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
    </participant>
    <messageFlow id="Id_3e36bf0f-a0df-4af4-9621-449e82858a03" sourceRef="Id_5a4584d3-0998-41f7-a95d-d512eb25ae2f" />
  </collaboration>
