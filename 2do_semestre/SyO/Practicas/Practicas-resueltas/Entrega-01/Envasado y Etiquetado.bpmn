    <exclusiveGateway id="Id_9736b78b-0ba4-45d6-a31a-385b03b58950" name="¿Lote conforme?" gatewayDirection="Diverging">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Decide seg&amp;uacute;n el an&amp;aacute;lisis de conformidad del lote&lt;/span&gt;&lt;/p&gt;</documentation>
