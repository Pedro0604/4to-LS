              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Valor 0: Materiales no disponibles. Se solicita la reposici&amp;oacute;n a dep&amp;oacute;sitos&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
