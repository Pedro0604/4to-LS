              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Valor 0: Lote no conforme&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Valor 1: Lote conforme&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="ca9a29f3-f9d8-4c5d-9e2c-27f52abe6213" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Valor 1: Lote conforme. Contin&amp;uacute;a el proceso de envasado y etiquetado hacia Registrar lote terminado&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
            <bizagi:BizagiExtendedAttributeValue Id="b4c34cb4-3bb7-4eb3-a0e1-7fe47ef1da47" Type="LongText">
              <bizagi:Content>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:11pt;font-weight:normal;font-style:normal;"&gt;Valor 0: Lote no conforme. Se contin&amp;uacute;a el proceso del lote no conforme hacia Separaci&amp;oacute;n de lote&lt;/span&gt;&lt;/p&gt;</bizagi:Content>
              <bizagi:TableValues />
            </bizagi:BizagiExtendedAttributeValue>
          </bizagi:BizagiExtendedAttributeValues>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_9d1f2f23-d64c-4438-8f4b-acdf63055121</incoming>
      <outgoing>Id_c048b5ff-8436-4337-b15b-a5c1a4d5bba2</outgoing>
